   ],
   "texto": "Área aberta em frente ao mural do rosto, com bananeiras no canto. Chão coberto de folhas secas de bananeira, com pedras e um pedaço de cano.",
   "tipo": "observacao",
   "titulo": "Antes do plantio",
   "_id": "antes-a4"
  },
